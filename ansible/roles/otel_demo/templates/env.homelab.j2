# {{ ansible_managed }}
# Loaded after the checkout's .env: these win.
# The images of this release, not upstream's default `latest`.
DEMO_VERSION={{ otel_demo_version }}
# service.version on every signal (OTEL_RESOURCE_ATTRIBUTES).
IMAGE_VERSION={{ otel_demo_version }}
# Upstream's resource attributes plus the environment Kibana's APM UI
# filters by (deployment.environment.name).
OTEL_RESOURCE_ATTRIBUTES=service.namespace=${OTEL_SERVICE_NAMESPACE},service.version=${IMAGE_VERSION},deployment.environment.name={{ otel_demo_environment }}
# The collector's extras layer: export to the EDOT gateway.
OTEL_COLLECTOR_CONFIG_EXTRAS={{ otel_demo_config_dir }}/otelcol-config-homelab.yml
